{
  "name": "@ghostline/ui-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/theme.css",
    "src/styles.css",
    "src/controller.css",
    "src/assets/fonts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./viewport": {
      "types": "./dist/viewport/index.d.ts",
      "import": "./dist/viewport/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/theme.css",
    "./controller.css": "./src/controller.css"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8796 --strictPort",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json",
    "build": "tsc -p tsconfig.build.json && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "build:demo": "vite build",
    "test": "tsx --test src/viewport/camera.test.ts src/viewport/nativeMaterials.test.ts src/viewport/playback.test.ts",
    "format": "prettier --write src demo *.json *.ts *.html README.md",
    "check": "npm run typecheck && npm test && npm run build && npm run build:demo"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "typescript": "^5.9.0",
    "tsx": "^4.21.0",
    "prettier": "^3.0.0",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
